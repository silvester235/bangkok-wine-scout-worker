/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bangkok-wine-scout-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-28",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"ai": {
		"binding": "AI"
	},
	"vars": {
		"AI_PROVIDER": "workers_ai",
		"AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
		"HIGH_THRESHOLD": "0.85",
		"LOW_THRESHOLD": "0.45",
		"AI_TIMEOUT_MS": "5000"
	},
	"queues": {
		"producers": [
			{
				"queue": "bangkok-wine-scout-processing",
				"binding": "IMAGE_PROCESSING_QUEUE"
			}
		],
		"consumers": [
			{
				"queue": "bangkok-wine-scout-processing",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_retries": 3
			}
		]
	},
	"r2_buckets": [
		{
			"binding": "EVENT_INTAKES",
			"bucket_name": "bangkok-wine-scout-intakes"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bangkok-wine-scout",
			"database_id": "0fe8aec8-170f-47da-8abb-303cae3d1103"
		}
	]
}
