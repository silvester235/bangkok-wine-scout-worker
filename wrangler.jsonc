/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bangkok-wine-scout-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-28",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"triggers": {
		"crons": ["*/2 * * * *", "0 3 1 * *"]
	},
	"ai": {
		"binding": "AI"
	},
	"vars": {
		"AI_PROVIDER": "workers_ai",
		"AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
		"EDITORIAL_VISION_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
		"CLOUDFLARE_ACCOUNT_ID": "5043abe3e62c4f0f4beed6b298a238f1",
		"HIGH_THRESHOLD": "0.85",
		"LOW_THRESHOLD": "0.45",
		"AI_TIMEOUT_MS": "5000",
		"LINE_TEXT_CONTEXT_WINDOW_SECONDS": "600",
		"LINE_IMAGE_BATCH_WINDOW_SECONDS": "15",
		"LINE_MESSAGE_BATCH_WINDOW_SECONDS": "60",
		"AGENT_SUBMISSION_WINDOW_SECONDS": "60",
		"AGENT_DONE_SETTLEMENT_SECONDS": "3",
		"PUBLIC_SITE_ORIGIN": "https://bangkokwinescout.com",
		"ENABLE_PUBLIC_EVENT_PAGES": "true",
		"INGESTION_MODE": "v2",
		"V2_PUBLICATION_ENABLED": "true"
	},
	"workflows": [
		{
			"binding": "WINE_SCOUT_SUBMISSION_WORKFLOW",
			"name": "bangkok-wine-scout-submission-v2",
			"class_name": "WineScoutSubmissionWorkflow"
		}
	],
	"queues": {
		"producers": [
			{
				"queue": "bangkok-wine-scout-processing",
				"binding": "IMAGE_PROCESSING_QUEUE"
			}
		],
		"consumers": [
			{
				"queue": "bangkok-wine-scout-processing",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_retries": 3
			}
		]
	},
	"r2_buckets": [
		{
			"binding": "EVENT_INTAKES",
			"bucket_name": "bangkok-wine-scout-intakes"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bangkok-wine-scout",
			"database_id": "0fe8aec8-170f-47da-8abb-303cae3d1103"
		}
	]
}
